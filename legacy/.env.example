# --- App ---
APP_ENV=development            # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ascendant_talent
# --- Sessions / auth ---
SESSION_SECRET=replace-with-64-random-chars
ADMIN_BOOTSTRAP_EMAIL=first.admin@example.com   # used once by db:seed
# --- Email (leave blank to disable; admin UI will show "not configured") ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_TALENT="Ascendant Talent <talent@example.com>"
EMAIL_FROM_GROUPS="Ascendant Groups <hello@example.com>"
EMAIL_STAFF_NOTIFY_TO=staff@example.com
# --- Private storage, S3-compatible (leave blank to disable CV upload) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CV_MAX_BYTES=5242880
# --- Retention (days; client must approve before launch) ---
RETENTION_ENQUIRY_DAYS=365
RETENTION_DOCUMENT_DAYS=180
# --- Analytics (optional, no PII is ever sent) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# --- Cron protection ---
CRON_SECRET=replace-with-random-string
# --- Optional link shown in footer once the parent domain is confirmed ---
NEXT_PUBLIC_PARENT_URL=
